{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Empresa"
    },
    "codigo": {
      "type": "string",
      "title": "C\u00f3digo"
    },
    "responsavel": {
      "type": "string",
      "title": "Respons\u00e1vel (CPF)"
    },
    "regime": {
      "type": "string",
      "title": "Regime"
    },
    "inscricao_estadual": {
      "type": "string",
      "title": "Inscri\u00e7\u00e3o Estadual (CGF)"
    },
    "inscricao_municipal": {
      "type": "string",
      "title": "Inscri\u00e7\u00e3o Municipal (ISS)"
    },
    "cnpj": {
      "type": "string",
      "title": "CNPJ"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}